{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 480,
  "height": 340,
  "padding": {
    "top": 15,
    "left": 5,
    "right": 5,
    "bottom": 5
  },

  "data": {
    "url": "data/bird_family_treemap.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [0, 100]
          }
        },

        "x2": {
          "field": "x1"
        },

        "y": {
          "field": "y0",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [0, 100],
            "reverse": true
          }
        },

        "y2": {
          "field": "y1"
        },

        "color": {
          "field": "Order Group",
          "type": "nominal",
          "title": "Bird order",
          "scale": {
            "domain": [
              "Passeriformes",
              "Charadriiformes",
              "Procellariiformes",
              "Psittaciformes",
              "Columbiformes",
              "Anseriformes",
              "Ciconiiformes",
              "Other orders"
            ],
            "range": [
              "#4C78A8",
              "#F28E2B",
              "#7E57C2",
              "#B279A2",
              "#6B7280",
              "#D4A72C",
              "#72B7B2",
              "#D9DEE5"
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleAnchor": "start",
            "columns": 4,
            "symbolType": "square",
            "symbolSize": 90,
            "labelFontSize": 9,
            "titleFontSize": 11,
            "labelLimit": 120
          }
        },

        "tooltip": [
          {
            "field": "Order",
            "type": "nominal",
            "title": "Bird order"
          },
          {
            "field": "Family",
            "type": "nominal",
            "title": "Bird family"
          },
          {
            "field": "Species Count",
            "type": "quantitative",
            "title": "Species count"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum['Species Count'] >= 15 && (datum.x1 - datum.x0) >= 10 && (datum.y1 - datum.y0) >= 7"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 9,
        "fontWeight": "bold"
      },

      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [0, 100]
          }
        },

        "y": {
          "field": "cy",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [0, 100],
            "reverse": true
          }
        },

        "text": {
          "field": "Family",
          "type": "nominal"
        },

        "color": {
          "condition": {
            "test": "datum['Order Group'] == 'Passeriformes' || datum['Order Group'] == 'Charadriiformes' || datum['Order Group'] == 'Procellariiformes'",
            "value": "white"
          },
          "value": "#1F2937"
        }
      }
    }
  ],

  "background": "white",

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}